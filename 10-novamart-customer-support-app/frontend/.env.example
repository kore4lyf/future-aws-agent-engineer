# Copy to .env.local and fill in. The app reads these at build time via Vite.

# --- AWS Cognito (required for real authentication) ---
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed for hosted-UI redirect flows; leave blank for password auth.
VITE_COGNITO_DOMAIN=

VITE_AWS_REGION=us-east-1

# --- Gateway ---
# Leave blank in development: Vite proxies /api to the gateway on :3001.
# Set an absolute URL for production builds, e.g. https://api.example.com
VITE_GATEWAY_URL=

# --- Demo mode ---
# true runs the whole app against local fakes (no AWS account required).
VITE_DEMO_MODE=false