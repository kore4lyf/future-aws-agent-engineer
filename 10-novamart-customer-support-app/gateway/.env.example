# Copy to .env and fill in. NEVER commit .env.

# --- AWS (the gateway signs AgentCore calls with the host's IAM role) ---
AWS_REGION=us-east-1

# --- Cognito (used to verify the bearer JWT the browser sends) ---
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_USER_POOL_REGION=us-east-1
COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AgentCore Runtime (the support agent) ---
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/xxxxxxxx
# Defaults to DEFAULT; set to hit a specific endpoint version, e.g. v2.
AGENT_RUNTIME_QUALIFIER=DEFAULT

# --- Optional DynamoDB history table ---
# Single-keyed on session_id; each item holds the whole conversation in a
# messages array. One GetItem loads a thread, one UpdateItem appends a message.
HISTORY_TABLE_NAME=novamart-agentcore-agent-sessions

# --- Local development ---
# true skips JWT verification and answers with canned replies (no AWS needed).
MOCK_MODE=false

# --- Server ---
PORT=3001
CORS_ORIGINS=http://localhost:5173
AGENT_TIMEOUT_MS=120000
MAX_MESSAGE_LENGTH=8000