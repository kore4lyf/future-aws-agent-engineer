# AWS Credentials
# Get these from AWS IAM → Users → Security credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here  # Required for temporary credentials

# AWS Region
AWS_REGION=us-east-1

# IAM Execution Role ARN for Bedrock Flows
# Create this role in AWS IAM Console
EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/AmazonBedrockExecutionRoleForFlows